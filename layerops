#!/usr/bin/env bash
#
# layerops
#
# Assess and remediate container image layers.
#
# ASSESS  — scans one or many images with Trivy and reports total vs fixable
#           vulnerabilities, split by package class:
#
#             os-pkgs    distro packages   (rpm / deb / apk — the base image layer)
#             lib-pkgs   language packages (jar, npm, pip, go modules — the app layer)
#
# REMEDIATE — with --patch, feeds the fixable os-pkgs findings to Copacetic (copa),
#           which rebuilds the image layer with patched distro packages. The result
#           is written as a NEW local tag; the original image is never touched.
#           copa cannot patch lib-pkgs — those need a dependency bump or app rebuild.
#
#           Patching uses a two-pass strategy for resilience:
#             Pass 1 (precise)      — copa with a filtered Trivy report (-r).
#             Pass 2 (comprehensive) — if pass 1 fails, copa retries without -r,
#                                      using --ignore-errors to skip individual
#                                      package failures (e.g. epoch mismatches).
#                                      Pinned to the host's native CPU architecture
#                                      to avoid QEMU emulation timeouts on multi-
#                                      arch images.
#           With --cu, the report-based first pass is skipped entirely and every
#           image goes straight through comprehensive + --ignore-errors.
#
# Assess:        layerops --list images.txt --csv report.csv
# Assess + fix:  layerops --list images.txt --patch --verify
#

set -euo pipefail

PROG="${0##*/}"
VERSION="v4.1.0"
IMAGES=()
LIST=""
FROM_JSON=""
SAVE_JSON=""
JSON_DIR=""
CSV_OUT=""
HTML_OUT=""
CLASS_FILTER="all"
PKG_TYPES="os,library"
SEVERITIES=""
FAIL_ON_FIXABLE=0
QUIET=0

PATCH=0
COMPREHENSIVE_UPDATE=0
PATCH_SUFFIX="lo-delta"
VERIFY=0
COPA_ADDR=""
PATCH_TIMEOUT=""
COPA_QUIET=-1        # -1 = follow --quiet, 0 = show, 1 = hide

usage() {
  cat <<EOF
Usage: $PROG --image <repo:tag> [more --image ...] [options]
       $PROG --list <file> [options]
       $PROG --from-json <file> [options]

Assess container images for vulnerabilities, and optionally remediate the
fixable OS-package findings with Copacetic (copa) in the same run.

Input:
  -i, --image <ref>       Image to scan. Repeat the flag for several images.
  -l, --list <file>       File of image refs, one per line (# comments allowed).
  -f, --from-json <file>  Summarise an existing Trivy JSON report, no scanning.

Output:
  -c, --class <name>      os-pkgs | lib-pkgs | all         (default: all)
      --csv <file>        Write the full report as CSV (per-image + severity + CVEs)
      --html <file>       Write a standalone HTML report — every CVE, tabbed by
                          os-pkgs / lib-pkgs, searchable and filterable. Opens
                          offline, safe to share as a single file.
      --json-dir <dir>    Keep each image's raw Trivy JSON in this directory
  -o, --save-json <file>  Single-image mode: keep the raw Trivy JSON here

Scan:
  -p, --pkg-types <list>  Trivy package types              (default: os,library)
  -s, --severity <list>   Limit severities, e.g. CRITICAL,HIGH
  -q, --quiet             Suppress Trivy's progress output (and copa's, when patching)
      --fail-on-fixable   Exit 1 if any fixable vulnerability is found (CI gate)

Patch (Copacetic):
      --patch             Patch fixable os-pkgs findings with copa. Writes a new
                          local tag; the source image is never modified.
                          Two-pass strategy is used automatically:
                            Pass 1 — report-based patch (-r <trivy-report>): precise,
                                     targets only CVE-confirmed packages.
                            Pass 2 — if pass 1 fails, retries with copa --ignore-errors
                                     (comprehensive update, no report). Skips individual
                                     package failures such as epoch version mismatches.
                                     Pinned to the host's native CPU arch to avoid
                                     QEMU timeouts on multi-arch images.
      --cu                Skip the report-based first pass and patch all images with
                          copa --ignore-errors (comprehensive update). Useful when
                          report-based patching is known to fail (e.g. Oracle images,
                          epoch mismatches). Requires --patch.
      --patch-suffix <s>  Tag suffix for patched images       (default: $PATCH_SUFFIX)
                          nginx:1.30.3 -> nginx:1.30.3-$PATCH_SUFFIX
      --verify            Re-scan each patched image and report before -> after.
                          Without it, copa's exit status is taken at face value.
      --copa-addr <addr>  BuildKit address passed to copa -a, e.g. tcp://0.0.0.0:8888
      --patch-timeout <d>  Per-image copa timeout for both passes  (default: 15m).
                          15m is the default because comprehensive updates for large
                          images can easily exceed copa's built-in 5m limit.
                          Example: --patch-timeout 30m
  -qc, --copa-quiet       Hide copa's BuildKit progress and apt chatter. On failure
                          the captured output is still shown. Implied by --quiet.
  -Qc, --copa-verbose     Show copa's output even under --quiet.

  -V, --version           Print version and exit
      --doctor            Check that all dependencies are installed and report versions

  -h, --help              This help

Notes:
  copa patches OS packages only. Language packages (jar, npm, pip, go modules)
  cannot be patched in place — they need a dependency bump and an app rebuild.
  In a batch, an image that fails to patch is reported and the run continues.

  OS type detection: images without a recognised distro family (distroless, scratch)
  are labelled 'distroless' in the report instead of '-'.

  HTML report includes a 'Total closed' tile showing findings removed after patching,
  updated dynamically when --patch (and optionally --verify) is used.

  Multi-arch images: the comprehensive retry (pass 2) is pinned to the host's native
  CPU architecture (e.g. linux/arm64 on Apple Silicon, linux/amd64 on x86 machines)
  to avoid extremely slow QEMU emulation. The patched image is tagged to the expected
  ref so --verify and the HTML report work correctly.

Examples:
  $PROG --image quay.io/keycloak/keycloak:26.7.2
  $PROG --list images.txt --class lib-pkgs --csv lib-report.csv
  $PROG --list images.txt --patch --verify --csv full-report.csv
  $PROG --list images.txt --html report.html --csv report.csv
  $PROG --image nginx:1.30.3 --patch --patch-suffix hotfix
  $PROG --list images.txt --patch --verify --patch-timeout 30m
  $PROG --list images.txt --patch --cu --verify
EOF
}

die()  { printf '%s: %s\n' "$PROG" "$*" >&2; exit 2; }
warn() { printf '%s: %s\n' "$PROG" "$*" >&2; }

# ------------------------------------------------------------------ doctor ---
doctor() {
  local has_color=0
  [[ -t 1 ]] && has_color=1
  local G='' R='' Y='' D='' B='' RST=''
  if [[ $has_color -eq 1 ]]; then
    G='\033[0;32m' R='\033[0;31m' Y='\033[0;33m' D='\033[2m' B='\033[1m' RST='\033[0m'
  fi

  printf "${B}layerops %s${RST}\n" "$VERSION"
  printf "\n"

  # jq
  if command -v jq >/dev/null 2>&1; then
    printf "  ${G}✅${RST} jq:        %s\n" "$(jq --version 2>/dev/null)"
  else
    printf "  ${R}❌${RST} jq:        not installed\n"
  fi

  # trivy
  if command -v trivy >/dev/null 2>&1; then
    local tv
    tv="$(trivy version --format json 2>/dev/null | jq -r '.Version // empty' 2>/dev/null || trivy --version 2>/dev/null | head -1 || echo 'unknown')"
    printf "  ${G}✅${RST} trivy:     %s\n" "$tv"
  else
    printf "  ${R}❌${RST} trivy:     not installed\n"
  fi

  # copa
  if command -v copa >/dev/null 2>&1; then
    printf "  ${G}✅${RST} copa:      %s\n" "$(copa --version 2>/dev/null || echo 'unknown')"
  else
    printf "  ${R}❌${RST} copa:      not installed ${D}(only needed for --patch)${RST}\n"
  fi

  # docker
  if command -v docker >/dev/null 2>&1; then
    local dv
    dv="$(docker --version 2>/dev/null || echo 'unknown')"
    if docker info >/dev/null 2>&1; then
      printf "  ${G}✅${RST} docker:    %s\n" "$dv"
    else
      printf "  ${Y}⚠️${RST}  docker:    %s ${Y}(daemon not running)${RST}\n" "$dv"
    fi
  else
    printf "  ${R}❌${RST} docker:    not installed ${D}(only needed for --patch)${RST}\n"
  fi

  # buildkitd container
  if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
    local bk_state
    bk_state="$(docker inspect --format '{{.State.Status}}' buildkitd 2>/dev/null || echo 'not_found')"
    case "$bk_state" in
      running) printf "  ${G}✅${RST} buildkit:  container running\n" ;;
      *)       printf "  ${Y}⚠️${RST}  buildkit:  container %s ${D}(docker run -d --name buildkitd --privileged moby/buildkit)${RST}\n" "$bk_state" ;;
    esac
  else
    printf "  ${D}—${RST}  buildkit:  ${D}requires docker${RST}\n"
  fi

  printf "\n"
  printf "  ${D}Install everything: curl -sSL https://raw.githubusercontent.com/hrushikeshkuwlekar/layerops/main/scripts/install.sh | bash${RST}\n"
  exit 0
}

# ---------------------------------------------------------------- arguments --
while [[ $# -gt 0 ]]; do
  case "$1" in
    -i|--image)      [[ $# -ge 2 ]] || die "$1 needs a value"; IMAGES+=("$2");   shift 2 ;;
    -l|--list)       [[ $# -ge 2 ]] || die "$1 needs a value"; LIST="$2";        shift 2 ;;
    -f|--from-json)  [[ $# -ge 2 ]] || die "$1 needs a value"; FROM_JSON="$2";   shift 2 ;;
    -o|--save-json)  [[ $# -ge 2 ]] || die "$1 needs a value"; SAVE_JSON="$2";   shift 2 ;;
    --json-dir)      [[ $# -ge 2 ]] || die "$1 needs a value"; JSON_DIR="$2";    shift 2 ;;
    --csv)           [[ $# -ge 2 ]] || die "$1 needs a value"; CSV_OUT="$2";     shift 2 ;;
    --html)          [[ $# -ge 2 ]] || die "$1 needs a value"; HTML_OUT="$2";    shift 2 ;;
    -c|--class)      [[ $# -ge 2 ]] || die "$1 needs a value"; CLASS_FILTER="$2";shift 2 ;;
    -p|--pkg-types)  [[ $# -ge 2 ]] || die "$1 needs a value"; PKG_TYPES="$2";   shift 2 ;;
    -s|--severity)   [[ $# -ge 2 ]] || die "$1 needs a value"; SEVERITIES="$2";  shift 2 ;;
    -q|--quiet)      QUIET=1; shift ;;
    --fail-on-fixable) FAIL_ON_FIXABLE=1; shift ;;
    --patch)         PATCH=1; shift ;;
    --cu)            COMPREHENSIVE_UPDATE=1; shift ;;
    --patch-suffix)  [[ $# -ge 2 ]] || die "$1 needs a value"; PATCH_SUFFIX="$2";shift 2 ;;
    --verify)        VERIFY=1; shift ;;
    --copa-addr)     [[ $# -ge 2 ]] || die "$1 needs a value"; COPA_ADDR="$2";   shift 2 ;;
    --patch-timeout)  [[ $# -ge 2 ]] || die "$1 needs a value"; PATCH_TIMEOUT="$2";shift 2 ;;
    -qc|--copa-quiet)   COPA_QUIET=1; shift ;;
    -Qc|--copa-verbose) COPA_QUIET=0; shift ;;
    -V|--version)    printf '%s %s\n' "$PROG" "$VERSION"; exit 0 ;;
    --doctor)        doctor ;;
    -h|--help)       usage; exit 0 ;;
    -*)              die "unknown option: $1 (try --help)" ;;
    *)               IMAGES+=("$1"); shift ;;
  esac
done

case "$CLASS_FILTER" in
  lib-pkgs|libraries|lang-pkgs) CLASS_FILTER="lang-pkgs" ;;   # accept all, normalise
  all|os-pkgs) ;;
  *) die "--class must be os-pkgs, lib-pkgs or all" ;;
esac

command -v jq >/dev/null 2>&1 || die "jq is required (brew install jq)"

# patch preflight — fail early rather than after a long scan
if [[ $PATCH -eq 1 ]]; then
  [[ -n "$FROM_JSON" ]] && die "--patch needs real images; it cannot be used with --from-json"
  [[ -n "$PATCH_SUFFIX" ]] || die "--patch-suffix cannot be empty"
  command -v copa >/dev/null 2>&1 \
    || die "copa is required for --patch — https://project-copacetic.github.io/copacetic/"
  if ! command -v docker >/dev/null 2>&1 && [[ -z "$COPA_ADDR" ]]; then
    warn "docker not found and --copa-addr not set; copa needs a BuildKit endpoint"
  fi
fi
[[ $VERIFY -eq 1 && $PATCH -eq 0 ]] && warn "--verify has no effect without --patch"
[[ $COMPREHENSIVE_UPDATE -eq 1 && $PATCH -eq 0 ]] && die "--cu requires --patch"

# copa output follows --quiet unless explicitly overridden
[[ $COPA_QUIET -eq -1 ]] && COPA_QUIET=$QUIET

# read the image list file
if [[ -n "$LIST" ]]; then
  [[ -f "$LIST" ]] || die "no such file: $LIST"
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"                       # strip comments
    line="$(printf '%s' "$line" | tr -d '\r' | awk '{$1=$1;print}')"
    [[ -n "$line" ]] && IMAGES+=("$line")
  done < "$LIST"
fi

if [[ ${#IMAGES[@]} -eq 0 && -z "$FROM_JSON" ]]; then usage >&2; exit 2; fi

WORKDIR=""
cleanup() { [[ -n "$WORKDIR" && -d "$WORKDIR" ]] && rm -rf "$WORKDIR"; return 0; }
trap cleanup EXIT

# display name for a Trivy class
display_class() { case "$1" in lang-pkgs) printf 'lib-pkgs';; *) printf '%s' "$1";; esac; }

# -------------------------------------------------------------------- scan ---
JSONS=()
LABELS=()
FAILED=()

if [[ -n "$FROM_JSON" ]]; then
  [[ -f "$FROM_JSON" ]] || die "no such file: $FROM_JSON"
  jq -e . "$FROM_JSON" >/dev/null 2>&1 || die "not valid JSON: $FROM_JSON"
  JSONS+=("$FROM_JSON")
  LABELS+=("$(basename "$FROM_JSON")")
else
  command -v trivy >/dev/null 2>&1 || die "trivy is required (brew install trivy)"
  WORKDIR="$(mktemp -d "${TMPDIR:-/tmp}/layerops.XXXXXX")" || die "could not create temp dir"
  [[ -n "$JSON_DIR" ]] && mkdir -p "$JSON_DIR"

  total=${#IMAGES[@]}
  n=0
  for img in "${IMAGES[@]}"; do
    n=$((n + 1))
    if [[ $total -eq 1 && -n "$SAVE_JSON" ]]; then
      out="$SAVE_JSON"
    elif [[ -n "$JSON_DIR" ]]; then
      out="$JSON_DIR/$(printf '%s' "$img" | tr '/:@ ' '____').json"
    else
      out="$WORKDIR/$(printf '%s' "$img" | tr '/:@ ' '____').json"
    fi

    args=(image --pkg-types "$PKG_TYPES" --scanners vuln --format json --output "$out")
    [[ -n "$SEVERITIES" ]] && args+=(--severity "$SEVERITIES")
    [[ $QUIET -eq 1 ]] && args+=(--quiet)
    args+=("$img")

    printf '%s: [%d/%d] scanning %s\n' "$PROG" "$n" "$total" "$img" >&2
    if trivy "${args[@]}" && jq -e . "$out" >/dev/null 2>&1; then
      JSONS+=("$out")
      LABELS+=("$img")
    else
      warn "SKIPPED (scan failed): $img"
      FAILED+=("$img")
    fi
  done
  echo >&2

  [[ ${#JSONS[@]} -eq 0 ]] && die "no image could be scanned"
fi

# ------------------------------------------------------------------ render ---
pretty() { if command -v column >/dev/null 2>&1; then column -t -s $'\t'; else cat; fi; }

# classes present across all reports, os-pkgs / lang-pkgs first
found="$(jq -rn '[ inputs | .Results[]? | select((( .Vulnerabilities // []) | length) > 0)
                  | .Class // "unknown" ] | unique[]' "${JSONS[@]}")"

CLASSES=()
if [[ "$CLASS_FILTER" != "all" ]]; then
  CLASSES=("$CLASS_FILTER")
else
  for want in os-pkgs lang-pkgs; do
    grep -qx -- "$want" <<<"$found" && CLASSES+=("$want")
  done
  while IFS= read -r c; do
    [[ -n "$c" ]] || continue
    case "$c" in os-pkgs|lang-pkgs) ;; *) CLASSES+=("$c") ;; esac
  done <<<"$found"
fi

if [[ ${#CLASSES[@]} -eq 0 ]]; then
  echo "No vulnerabilities found."
  exit 0
fi

# severity table for one class across the given report files
severity_table() {
  local class="$1"; shift
  jq -rn --arg c "$class" '
    def rank: {"CRITICAL":0,"HIGH":1,"MEDIUM":2,"LOW":3,"UNKNOWN":4}[.] // 5;
    def fixable: [.[] | select((.FixedVersion // "") != "")] | length;
    def unfixed: [.[] | select((.FixedVersion // "") == "")] | length;
    [ inputs | .Results[]? | select((.Class // "unknown") == $c) | (.Vulnerabilities // [])[] ] as $v
    | (["SEVERITY","TOTAL","FIXABLE","UNFIXED"] | @tsv),
      ( $v | group_by(.Severity) | sort_by(.[0].Severity | rank)[]
           | [ .[0].Severity, length, fixable, unfixed ] | @tsv ),
      ( ["TOTAL", ($v|length), ($v|fixable), ($v|unfixed)] | @tsv )
  ' "$@"
}

# one row of counts for one class in one report file
counts_row() {
  jq -r --arg c "$1" '
    [ .Results[]? | select((.Class // "unknown") == $c) | (.Vulnerabilities // [])[] ] as $v
    | [ ($v|length),
        ([$v[] | select((.FixedVersion // "") != "")] | length),
        ([$v[] | select((.FixedVersion // "") == "")] | length) ] | @tsv
  ' "$2"
}

# the "type" of an image for a class:
#   os-pkgs   -> the detected distro, e.g. "debian 12.5", "redhat 9.8", "alpine 3.19"
#   lang-pkgs -> the language package types present, e.g. "jar", "jar,gobinary"
type_for() {
  local class="$1" file="$2"
  if [[ "$class" == "os-pkgs" ]]; then
    jq -r '
      (.Metadata.OS.Family // "") as $f | (.Metadata.OS.Name // "") as $n
      | if $f == "" then "distroless"
        else $f + (if $n == "" then "" else " " + $n end) end' "$file"
  else
    jq -r --arg c "$class" '
      [ .Results[]? | select((.Class // "unknown") == $c) | .Type // empty ]
      | unique | join(",") | if . == "" then "-" else . end' "$file"
  fi
}

MULTI=0
[[ ${#JSONS[@]} -gt 1 ]] && MULTI=1

# single-image mode: identify the image up front
if [[ $MULTI -eq 0 ]]; then
  {
    printf 'IMAGE:\t%s\n' "${LABELS[0]}"
    printf 'OS:\t%s\n'    "$(type_for os-pkgs "${JSONS[0]}")"
    printf 'LIB-PKGS:\t%s\n'  "$(type_for lang-pkgs "${JSONS[0]}")"
  } | pretty
  echo
fi

for class in "${CLASSES[@]}"; do
  if [[ $MULTI -eq 1 ]]; then
    echo "=== $(display_class "$class") — per image ==="
    {
      printf 'IMAGE\tTYPE\tTOTAL\tFIXABLE\tUNFIXED\n'
      for i in "${!JSONS[@]}"; do
        printf '%s\t%s\t%s\n' "${LABELS[$i]}" \
          "$(type_for "$class" "${JSONS[$i]}")" \
          "$(counts_row "$class" "${JSONS[$i]}")"
      done
    } | pretty
    echo
    echo "=== $(display_class "$class") — master total (${#JSONS[@]} images) ==="
  else
    echo "=== $(display_class "$class") ($(type_for "$class" "${JSONS[0]}")) ==="
  fi

  severity_table "$class" "${JSONS[@]}" | pretty
  echo

  if [[ $MULTI -eq 1 ]]; then
    jq -rn --arg c "$class" '
      [ inputs | .Results[]? | select((.Class // "unknown") == $c) | (.Vulnerabilities // [])[] ] as $v
      | "distinct CVEs: \($v | map(.VulnerabilityID) | unique | length)   " +
        "distinct fixable: \($v | map(select((.FixedVersion // "") != "") | .VulnerabilityID) | unique | length)   " +
        "distinct unfixed: \($v | map(select((.FixedVersion // "") == "") | .VulnerabilityID) | unique | length)"
    ' "${JSONS[@]}"
    echo
  fi
done

# ------------------------------------------------------------------- patch ---
# copa consumes a Trivy report and patches only OS packages that carry a fixed
# version. Rather than re-scanning, derive that report from the JSON we already
# have: keep os-pkgs results, drop findings with no FixedVersion.
copa_report() {
  jq '
    .Results = [ .Results[]?
      | select((.Class // "") == "os-pkgs")
      | .Vulnerabilities = [ (.Vulnerabilities // [])[]
                             | select((.FixedVersion // "") != "") ]
      | select((.Vulnerabilities | length) > 0) ]
  ' "$1" > "$2"
}

# nginx:1.30.3 -> 1.30.3-lo-delta   (copa -t takes the tag, not the full ref)
# quay.io/x/y  -> latest-lo-delta   (untagged refs resolve to :latest)
patched_tag() {
  local ref="${1%@*}" tag                    # drop any @sha256:... digest
  if [[ "${ref##*/}" == *:* ]]; then tag="${ref##*:}"; else tag="latest"; fi
  printf '%s-%s' "$tag" "$PATCH_SUFFIX"
}
patched_ref() {
  local ref="${1%@*}" repo
  if [[ "${ref##*/}" == *:* ]]; then repo="${ref%:*}"; else repo="$ref"; fi
  printf '%s:%s' "$repo" "$(patched_tag "$1")"
}

PATCH_ROWS=()
PATCH_OK=0; PATCH_FAIL=0; PATCH_SKIP=0
PATCH_FAILED_IMGS=()

if [[ $PATCH -eq 1 ]]; then
  echo "=== patch — copa (os-pkgs only) ==="

  # --- progress helpers: single-line status per image ---
  _patch_is_tty=0; [[ -t 2 ]] && _patch_is_tty=1
  _patch_line=""   # current progress line content
  # Start a new single-line progress (overwrites previous line if TTY)
  pstart() { _patch_line="$*"; printf '\r%s' "$_patch_line" >&2; }
  # Append a status token to the current line
  pappend() {
    _patch_line="${_patch_line} ... $*"
    if [[ $_patch_is_tty -eq 1 ]]; then
      printf '\r\033[2K%s' "$_patch_line" >&2
    else
      printf ' ... %s' "$*" >&2
    fi
  }
  # Finish the current progress line with a newline
  pend() {
    if [[ $# -gt 0 ]]; then pappend "$*"; fi
    printf '\n' >&2
  }

  ptotal=${#JSONS[@]}
  pn=0
  for i in "${!JSONS[@]}"; do
    pn=$((pn + 1))
    img="${LABELS[$i]}"
    src="${JSONS[$i]}"

    IFS=$'\t' read -r os_total os_fix _os_unfix <<<"$(counts_row os-pkgs "$src")"

    # nothing copa can act on — scratch/distroless images land here too
    if [[ "${os_fix:-0}" -eq 0 ]]; then
      PATCH_SKIP=$((PATCH_SKIP + 1))
      PATCH_ROWS+=("$(printf '%s\t-\t%s\t%s\tSKIPPED\t-\t-' "$img" "$os_total" "$os_fix")")
      printf '%s: [%d/%d] skipping %s (no fixable os-pkgs)\n' "$PROG" "$pn" "$ptotal" "$img" >&2
      continue
    fi

    newref="$(patched_ref "$img")"
    rep="$WORKDIR/copa-$(printf '%s' "$img" | tr '/:@ ' '____').json"
    copa_report "$src" "$rep"

    pstart "$(printf '%s: [%d/%d] patching %s' "$PROG" "$pn" "$ptotal" "$img")"

    # copa is loud: BuildKit progress bars plus every apt line. When quiet, capture
    # it and replay only on failure — silence when it works, diagnostics when it doesn't.
    clog="$WORKDIR/copa-log-$pn.txt"
    if [[ $COPA_QUIET -eq 1 ]]; then
      copa_run() { copa "$@" >"$clog" 2>&1; }
    else
      copa_run() { copa "$@" >&2; }
    fi

    # --- comprehensive-update helper (shared by --cu and fallback retry) ---
    # Builds args for copa --ignore-errors, pinned to host arch.
    run_comprehensive() {
      host_arch=""
      case "$(uname -m)" in
        x86_64|amd64)  host_arch="linux/amd64" ;;
        arm64|aarch64) host_arch="linux/arm64" ;;
        armv7*)        host_arch="linux/arm/v7" ;;
        *)             host_arch="" ;;   # let copa decide
      esac
      local rargs=(patch -i "$img" -t "$(patched_tag "$img")" --ignore-errors)
      [[ -n "$COPA_ADDR" ]] && rargs+=(-a "$COPA_ADDR")
      [[ -n "$host_arch" ]] && rargs+=(--platform "$host_arch")
      rargs+=(--timeout "${PATCH_TIMEOUT:-15m}")

      if ! copa_run "${rargs[@]}"; then
        return 1
      fi

      # Copa with --platform may append an arch suffix (e.g. -arm64), and Docker
      # daemon normalizes Docker Hub library images (stripping docker.io/library/).
      # Check all candidate tags in Docker daemon and alias to $newref.
      local arch_suffix=""
      case "$host_arch" in
        linux/amd64)  arch_suffix="-amd64" ;;
        linux/arm64)  arch_suffix="-arm64" ;;
        linux/arm/v7) arch_suffix="-armv7" ;;
      esac
      local found_img=""
      local candidates=(
        "$newref"
        "${newref}${arch_suffix}"
        "${newref#docker.io/library/}"
        "${newref#docker.io/library/}${arch_suffix}"
        "${newref#docker.io/}"
        "${newref#docker.io/}${arch_suffix}"
      )
      for cand in "${candidates[@]}"; do
        if [[ -n "$cand" ]] && docker image inspect "$cand" >/dev/null 2>&1; then
          found_img="$cand"
          break
        fi
      done
      if [[ -n "$found_img" ]]; then
        [[ "$found_img" != "$newref" ]] && docker tag "$found_img" "$newref" >/dev/null 2>&1
        return 0
      else
        return 1
      fi
    }

    # --- patch strategy ---
    copa_ok=0
    if [[ $COMPREHENSIVE_UPDATE -eq 1 ]]; then
      # --cu: go straight to comprehensive + --ignore-errors
      pappend "exhaustive processing"
      if run_comprehensive; then
        copa_ok=1
      fi
    else
      # Two-pass: try report-based first, fallback to comprehensive
      cargs=(patch -i "$img" -r "$rep" -t "$(patched_tag "$img")")
      [[ -n "$COPA_ADDR" ]] && cargs+=(-a "$COPA_ADDR")
      cargs+=(--timeout "${PATCH_TIMEOUT:-15m}")

      if copa_run "${cargs[@]}"; then
        # If docker daemon normalized the name (e.g. stripped docker.io/library/), alias to $newref
        if ! docker image inspect "$newref" >/dev/null 2>&1; then
          for cand in "${newref#docker.io/library/}" "${newref#docker.io/}"; do
            if docker image inspect "$cand" >/dev/null 2>&1; then
              docker tag "$cand" "$newref" >/dev/null 2>&1
              break
            fi
          done
        fi
        copa_ok=1
      else
        pappend "exhaustive processing"
        if run_comprehensive; then
          copa_ok=1
        fi
      fi
    fi

    if [[ $copa_ok -eq 1 ]]; then
      PATCH_OK=$((PATCH_OK + 1))
      after_total="-"; after_fix="-"; removed="-"

      if [[ $VERIFY -eq 1 ]]; then
        pappend "verification in progress"
        vout="$WORKDIR/verify-$(printf '%s' "$newref" | tr '/:@ ' '____').json"
        vargs=(image --pkg-types os --scanners vuln --format json --output "$vout")
        [[ -n "$SEVERITIES" ]] && vargs+=(--severity "$SEVERITIES")
        [[ $QUIET -eq 1 ]] && vargs+=(--quiet)
        vargs+=("$newref")

        if trivy "${vargs[@]}" && jq -e . "$vout" >/dev/null 2>&1; then
          IFS=$'\t' read -r after_total after_fix _av <<<"$(counts_row os-pkgs "$vout")"
          removed=$(( os_total - after_total ))
        else
          after_total="ERR"; after_fix="ERR"; removed="-"
        fi
      fi

      pend "$newref"
      PATCH_ROWS+=("$(printf '%s\t%s\t%s\t%s\tPATCHED\t%s\t%s' \
        "$img" "$newref" "$os_total" "$os_fix" "$after_total" "$removed")")
    else
      pend "FAILED"
      PATCH_FAIL=$((PATCH_FAIL + 1))
      PATCH_FAILED_IMGS+=("$img")
      # Show copa output only when explicitly asked via --copa-verbose
      if [[ $COPA_QUIET -eq 0 && -s "$clog" ]]; then
        printf '  --- copa output (last 15 lines) ---\n' >&2
        tail -n 15 "$clog" | sed 's/^/  /' >&2
        printf '  -----------------------------------\n' >&2
      fi
      PATCH_ROWS+=("$(printf '%s\t-\t%s\t%s\tFAILED\t-\t-' "$img" "$os_total" "$os_fix")")
    fi
  done
  echo >&2

  {
    printf 'IMAGE\tPATCHED TAG\tOS BEFORE\tFIXABLE\tSTATUS\tOS AFTER\tREMOVED\n'
    printf '%s\n' "${PATCH_ROWS[@]}"
  } | pretty
  echo

  printf 'patched: %d   failed: %d   skipped (nothing fixable): %d\n' \
    "$PATCH_OK" "$PATCH_FAIL" "$PATCH_SKIP"
  if [[ $VERIFY -eq 1 ]]; then
    closed_sum=0
    for row in "${PATCH_ROWS[@]}"; do
      rem="$(printf '%s' "$row" | cut -f7)"
      [[ "$rem" =~ ^[0-9]+$ ]] && closed_sum=$(( closed_sum + rem ))
    done
    printf 'closed: %d findings removed across %d patched image(s) (verified)\n' \
      "$closed_sum" "$PATCH_OK"
  else
    closed_sum=0
    for row in "${PATCH_ROWS[@]}"; do
      st="$(printf '%s' "$row" | cut -f5)"
      if [[ "$st" == "PATCHED" ]]; then
        fix="$(printf '%s' "$row" | cut -f4)"
        [[ "$fix" =~ ^[0-9]+$ ]] && closed_sum=$(( closed_sum + fix ))
      fi
    done
    printf 'closed: %d fixable findings patched across %d image(s) (unverified)\n' \
      "$closed_sum" "$PATCH_OK"
    echo "(copa exit status taken at face value — add --verify to re-scan)"
  fi
  echo
fi

# --------------------------------------------------------------------- csv ---
if [[ -n "$CSV_OUT" ]]; then
  {
    # --- Section 1: per-image breakdown ---
    echo "## Per-Image Breakdown"
    printf '%s\n' "image,os_type,os_total,os_fixable,os_unfixed,lib_type,lib_total,lib_fixable,lib_unfixed,grand_total,grand_fixable,grand_unfixed"
    for i in "${!JSONS[@]}"; do
      os_type="$(type_for os-pkgs "${JSONS[$i]}")"
      os_counts="$(counts_row os-pkgs "${JSONS[$i]}")"
      lib_type="$(type_for lang-pkgs "${JSONS[$i]}")"
      lib_counts="$(counts_row lang-pkgs "${JSONS[$i]}")"

      IFS=$'\t' read -r ot of ou <<<"$os_counts"
      IFS=$'\t' read -r lt lf lu <<<"$lib_counts"
      gt=$(( ot + lt )); gf=$(( of + lf )); gu=$(( ou + lu ))

      printf '%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s\n' \
        "${LABELS[$i]}" "$os_type" "$ot" "$of" "$ou" \
        "$lib_type" "$lt" "$lf" "$lu" "$gt" "$gf" "$gu"
    done
    echo

    # --- Section 2: severity totals per class ---
    for class in "${CLASSES[@]}"; do
      echo "## $(display_class "$class") — severity totals (${#JSONS[@]} images)"
      echo "severity,total,fixable,unfixed"
      jq -rn --arg c "$class" '
        def rank: {"CRITICAL":0,"HIGH":1,"MEDIUM":2,"LOW":3,"UNKNOWN":4}[.] // 5;
        def fixable: [.[] | select((.FixedVersion // "") != "")] | length;
        def unfixed: [.[] | select((.FixedVersion // "") == "")] | length;
        [ inputs | .Results[]? | select((.Class // "unknown") == $c)
          | (.Vulnerabilities // [])[] ] as $v
        | ( $v | group_by(.Severity) | sort_by(.[0].Severity | rank)[]
             | [ .[0].Severity, length, fixable, unfixed ] | @csv ),
          ( ["TOTAL", ($v|length), ($v|fixable), ($v|unfixed)] | @csv )
      ' "${JSONS[@]}"
      echo
    done

    # --- Section 3: distinct CVE counts per class ---
    if [[ $MULTI -eq 1 ]]; then
      echo "## Distinct CVE Counts"
      echo "class,distinct_cves,distinct_fixable,distinct_unfixed"
      for class in "${CLASSES[@]}"; do
        jq -rn --arg c "$class" --arg cn "$(display_class "$class")" '
          [ inputs | .Results[]? | select((.Class // "unknown") == $c)
            | (.Vulnerabilities // [])[] ] as $v
          | [ $cn,
              ($v | map(.VulnerabilityID) | unique | length),
              ($v | map(select((.FixedVersion // "") != "") | .VulnerabilityID) | unique | length),
              ($v | map(select((.FixedVersion // "") == "") | .VulnerabilityID) | unique | length)
            ] | @csv
        ' "${JSONS[@]}"
      done
      echo
    fi

    # --- Section 4: patch results ---
    if [[ $PATCH -eq 1 ]]; then
      echo "## Patch Results (copa, os-pkgs only)"
      echo "image,patched_tag,os_before,os_fixable,status,os_after,removed"
      for row in "${PATCH_ROWS[@]}"; do
        printf '%s\n' "$row" | tr '\t' ','
      done
    fi
  } > "$CSV_OUT"
  printf '%s: wrote %s\n' "$PROG" "$CSV_OUT" >&2
fi

# -------------------------------------------------------------------- html ---
# A standalone report: every finding, tabbed by class, filterable, shareable.
# Data is normalised (image + severity as indices, titles deduped by CVE) so a
# large estate stays a file you can email rather than a multi-megabyte dump.
write_html() {
  local out="$1" i ot of ou lt lf lu failed_json='[]' patch_json='[]'

  if [[ ${#FAILED[@]} -gt 0 ]]; then
    failed_json="$(printf '%s\n' "${FAILED[@]}" | jq -Rsc 'split("\n")|map(select(length>0))')"
  fi
  if [[ ${#PATCH_ROWS[@]} -gt 0 ]]; then
    patch_json="$(printf '%s\n' "${PATCH_ROWS[@]}" \
                  | jq -Rsc 'split("\n")|map(select(length>0)|split("\t"))')"
  fi

  {
    cat <<'LAYEROPS_HTML_HEAD'
