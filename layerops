      <th class="s" data-k="libtype">Lib type<span class="ar"></span></th>
      <th class="s" data-k="lt" style="text-align:right">Lib total<span class="ar"></span></th>
      <th class="s" data-k="lf" style="text-align:right">Lib fixable<span class="ar"></span></th>
      <th class="s" data-k="gt" style="text-align:right">Total<span class="ar"></span></th>
    </tr></thead><tbody></tbody>
  </table></div>
  <div id="ov-empty"></div>
</section>

<!-- os + lib share one markup shape -->
<section class="panel" id="p-os" role="tabpanel"></section>
<section class="panel" id="p-lib" role="tabpanel"></section>

<!-- patch -->
<section class="panel" id="p-patch" role="tabpanel">
  <div class="note" id="patch-note"></div>
  <div class="tw"><table id="pt-t">
    <thead><tr>
      <th>Image</th><th>Patched tag</th>
      <th style="text-align:right">OS-pkg before</th><th style="text-align:right">Fixable</th>
      <th>Status</th>
      <th style="text-align:right">OS-pkg after</th><th style="text-align:right">Removed</th>
    </tr></thead><tbody></tbody>
  </table></div>
</section>

<footer id="foot"></footer>
</div>
<div class="toast" id="toast"></div>

<script>
/* ====================================================== data (injected) == */
LAYEROPS_HTML_HEAD

    # image list — every other structure refers to images by index
    printf 'const IMGS=%s;\n' \
      "$(printf '%s\n' "${LABELS[@]}" | jq -Rsc 'split("\n")|map(select(length>0))')"

    # one compact row per finding:
    # [imgIdx, class(0=os,1=lib), type, cve, severity(0-4), pkg, installed, fixed]
    printf 'const ROWS=[%s];\n' "$(
    for i in "${!JSONS[@]}"; do
      jq -c --argjson ix "$i" '
        def sevi: {"CRITICAL":0,"HIGH":1,"MEDIUM":2,"LOW":3}[.] // 4;
        .Results[]?
        | (.Class // "") as $c
        | select($c == "os-pkgs" or $c == "lang-pkgs")
        | (.Type // "") as $t
        | (.Vulnerabilities // [])[]
        | [ $ix, (if $c == "os-pkgs" then 0 else 1 end), $t,
            (.VulnerabilityID // ""), ((.Severity // "UNKNOWN") | sevi),
            (.PkgName // ""), (.InstalledVersion // ""), (.FixedVersion // "") ]
      ' "${JSONS[$i]}"
    done | paste -sd, -)"

    # titles stored once per CVE, not once per occurrence
    printf 'const TITLES=%s;\n' "$(jq -nc '[ inputs | .Results[]?
              | select((.Class // "") == "os-pkgs" or (.Class // "") == "lang-pkgs")
              | (.Vulnerabilities // [])[]
              | select((.Title // "") != "")
              | {key: .VulnerabilityID, value: .Title} ] | from_entries' "${JSONS[@]}")"

    # per-image summary, same numbers as the terminal table
    printf 'const IMAGES_SUMMARY=[%s];\n' "$(
    for i in "${!JSONS[@]}"; do
      IFS=$'\t' read -r ot of ou <<<"$(counts_row os-pkgs "${JSONS[$i]}")"
      IFS=$'\t' read -r lt lf lu <<<"$(counts_row lang-pkgs "${JSONS[$i]}")"
      jq -nc --arg img "${LABELS[$i]}" \
             --arg ostype  "$(type_for os-pkgs   "${JSONS[$i]}")" \
             --arg libtype "$(type_for lang-pkgs "${JSONS[$i]}")" \
             --argjson ot "$ot" --argjson of "$of" \
             --argjson lt "$lt" --argjson lf "$lf" \
             '{img:$img, ostype:$ostype, ot:$ot, of:$of,
               libtype:$libtype, lt:$lt, lf:$lf, gt:($ot+$lt)}'
    done | paste -sd, -)"

    printf 'const META=%s;\n' "$(jq -nc --arg v "$VERSION" --arg g "$(date '+%Y-%m-%d %H:%M %Z')" \
           --argjson n "${#JSONS[@]}" --argjson f "$failed_json" \
           '{version:$v, generated:$g, images:$n, failed:$f}')"

    printf 'const PATCH=%s;\n' "$patch_json"

    cat <<'LAYEROPS_HTML_TAIL'
/* ====================================================== /data =========== */

(function () {
"use strict";
var SEV = ["CRITICAL","HIGH","MEDIUM","LOW","UNKNOWN"];
var SEVVAR = ["--crit","--high","--med","--low","--unk"];
var PAGE = 100;

/* ROWS: [imgIdx, cls(0=os,1=lib), type, cve, sev, pkg, installed, fixed] */
var R_IMG=0, R_CLS=1, R_TYPE=2, R_CVE=3, R_SEV=4, R_PKG=5, R_INST=6, R_FIX=7;

function esc(s){ return String(s==null?"":s); }
function el(tag, cls, txt){
  var e = document.createElement(tag);
  if (cls) e.className = cls;
  if (txt != null) e.textContent = txt;   // never innerHTML for data
  return e;
}
function cveHref(id){
  if (/^CVE-/i.test(id)) return "https://nvd.nist.gov/vuln/detail/" + encodeURIComponent(id);
  if (/^GHSA-/i.test(id)) return "https://github.com/advisories/" + encodeURIComponent(id);
  return "https://www.google.com/search?q=" + encodeURIComponent(id);
}
function toast(msg){
  var t = document.getElementById("toast");
  t.textContent = msg; t.classList.add("on");
  clearTimeout(toast._t); toast._t = setTimeout(function(){ t.classList.remove("on"); }, 1900);
}
function csvCell(v){
  v = v == null ? "" : String(v);
  return /[",\n]/.test(v) ? '"' + v.replace(/"/g,'""') + '"' : v;
}
function csvOut(head, rows, name){
  var text = head.join(",") + "\n" + rows.map(function(r){ return r.map(csvCell).join(","); }).join("\n");
  var done = function(){ toast(rows.length.toLocaleString() + " rows copied to clipboard"); };
  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(text).then(done, function(){ fallback(text, name); });
  } else fallback(text, name);
}
function fallback(text, name){
  try {
    var b = new Blob([text], {type:"text/csv"});
    var a = document.createElement("a");
    a.href = URL.createObjectURL(b); a.download = name;
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
    setTimeout(function(){ URL.revokeObjectURL(a.href); }, 4000);
    toast("Downloaded " + name);
  } catch (e) { toast("Could not export — select the table and copy manually"); }
}

/* ------------------------------------------------------------ derived --- */
var byCls = [[],[]];
ROWS.forEach(function(r){ byCls[r[R_CLS]].push(r); });

function sevCounts(rows){
  var c = [0,0,0,0,0];
  rows.forEach(function(r){ c[r[R_SEV]]++; });
  return c;
}
function fixCounts(rows){
  var f=0,u=0;
  rows.forEach(function(r){ if (r[R_FIX]) f++; else u++; });
  return {fixable:f, unfixed:u};
}

/* ---------------------------------------------------------------- head --- */
document.getElementById("m-tool").textContent = "layerops " + (META.version||"");
document.getElementById("m-when").textContent = META.generated || "";
var totOs = byCls[0].length, totLib = byCls[1].length;

/* Fixable / unfixed are reported against os-pkgs ALONE. --patch touches distro packages
   and nothing else, so a blended number would merge automatable patching with
   library findings that need a dependency bump and an application rebuild. */
var osFix  = fixCounts(byCls[0]);
var libFix = fixCounts(byCls[1]);
var distinctOs  = new Set(byCls[0].map(function(r){ return r[R_CVE]; })).size;
var distinctLib = new Set(byCls[1].map(function(r){ return r[R_CVE]; })).size;

var patchRan = PATCH && PATCH.length > 0;
var totalClosed = 0;
var hasVerified = false;
var patchOk = 0;

if (patchRan) {
  var patchVerifiedSum = 0;
  var patchUnverifiedSum = 0;

  PATCH.forEach(function(p){
    if (p[4] === "PATCHED") {
      patchOk++;
      var rem = (p[6] !== "-" && p[6] !== "ERR" && p[6] !== "" && !isNaN(parseInt(p[6], 10)))
                ? parseInt(p[6], 10) : null;
      if (rem !== null) {
        hasVerified = true;
        patchVerifiedSum += rem;
      }
      var fix = parseInt(p[3], 10) || 0;
      patchUnverifiedSum += fix;
    }
  });

  totalClosed = hasVerified ? patchVerifiedSum : patchUnverifiedSum;

  // Post-patch total OS findings: use osAfter (verified) for patched images,
  // osBefore for skipped/failed images (nothing changed for them).
  var postPatchOs = 0;
  PATCH.forEach(function(p){
    var osBefore = parseInt(p[2], 10) || 0;
    var osAfter  = (p[5] !== "-" && p[5] !== "ERR" && p[5] !== "" && !isNaN(parseInt(p[5], 10)))
                   ? parseInt(p[5], 10) : null;
    if (p[4] === "PATCHED" && osAfter !== null) {
      postPatchOs += osAfter;
    } else {
      postPatchOs += osBefore;
    }
  });
}

document.getElementById("m-sub").textContent =
  META.images + " image" + (META.images===1?"":"s") + " scanned · " +
  (totOs+totLib).toLocaleString() + " findings · " +
  (new Set(ROWS.map(function(r){return r[R_CVE];})).size).toLocaleString() + " distinct CVEs" +
  (patchRan && totalClosed > 0
    ? " · " + totalClosed.toLocaleString() + " closed" + (hasVerified ? "" : " (unverified)")
    : "");

var PANELS = {};   /* filled in by buildPanel; tiles drive the panels through it */

var tiles = [
  {lab:"Images scanned", val:META.images,
   foot:(META.failed && META.failed.length ? META.failed.length+" failed" : "all succeeded")},

  {lab:"Total findings", val:(totOs+totLib),
   foot:totOs.toLocaleString()+" OS-pkg · "+totLib.toLocaleString()+" lib-pkg"}
];

if (patchRan && !hasVerified) {
  /* --patch without --verify: show unverified closed count near the top */
  var grandTotal = totOs + totLib;
  var pctTotal = grandTotal > 0 ? Math.round(totalClosed / grandTotal * 100) : 0;
  tiles.push({
    lab: "Total closed",
    val: totalClosed,
    cls: totalClosed > 0 ? "ok" : (patchOk === 0 ? "crit" : ""),
    foot: pctTotal + "% of total findings · unverified",
    go: {tab: "patch", cta: "Patch results"}
  });
}

tiles.push(
  {lab:"OS-pkg fixable", val:osFix.fixable, cls:"ok",
   foot:(totOs ? Math.round(osFix.fixable/totOs*100) : 0)+"% of OS-pkg",
   go:{tab:"os", mode:"flat", fix:"fixable", cta:"Distro packages"}},

  {lab:"OS-pkg unfixed", val:osFix.unfixed, cls:"crit",
   foot:"no vendor patch exists",
   go:{tab:"os", mode:"flat", fix:"unfixed", cta:"Distro packages"}},

  {lab:"Library findings", val:totLib, cls:"warn",
   foot:libFix.fixable.toLocaleString()+" have a fix · needs rebuild",
   go:{tab:"lib", mode:"flat", fix:"", cta:"Libraries"}},

  {lab:"Distinct CVEs · OS-pkg", val:distinctOs, cls:"acc",
   foot:"unique across "+META.images+" image"+(META.images===1?"":"s"),
   go:{tab:"os", mode:"cve", fix:"", cta:"List CVEs"}},

  {lab:"Distinct CVEs · Libraries", val:distinctLib, cls:"acc",
   foot:"unique across "+META.images+" image"+(META.images===1?"":"s"),
   go:{tab:"lib", mode:"cve", fix:"", cta:"List CVEs"}}
);

if (patchRan && hasVerified) {
  var postPatchTotal = postPatchOs + totLib;
  var postPct = (totOs + totLib) > 0
    ? Math.round(postPatchTotal / (totOs + totLib) * 100) : 0;

  tiles.push(
    {
      lab: "Total closed",
      val: totalClosed,
      cls: totalClosed > 0 ? "ok" : (patchOk === 0 ? "crit" : ""),
      foot: Math.round(totalClosed / (totOs + totLib) * 100) + "% of total findings · verified",
      go: {tab: "patch", cta: "Patch results"}
    },
    {
      lab: "Total findings post patch",
      val: postPatchTotal,
      cls: postPatchTotal < (totOs + totLib) ? "ok" : "",
      foot: postPatchOs.toLocaleString() + " OS-pkg · " + totLib.toLocaleString() + " lib-pkg · " + postPct + "% of pre-patch",
      go: {tab: "patch", cta: "Patch results"}
    }
  );
}

var tw = document.getElementById("tiles");
tiles.forEach(function(t){
  var d = el(t.go ? "button" : "div", "tile"+(t.cls?" "+t.cls:"")+(t.go?" act":""));
  if (t.go) d.type = "button";
  d.appendChild(el("div","lab",t.lab));
  d.appendChild(el("div","val", Number(t.val).toLocaleString()));
  d.appendChild(el("div","foot",t.foot));
  if (t.go) {
    d.appendChild(el("span","go", t.go.cta + " →"));
    d.addEventListener("click", function(){
      select(t.go.tab);
      var p = PANELS[t.go.tab];
      if (p) p.apply(t.go.mode, t.go.fix);
      var host = document.getElementById("p-"+t.go.tab);
      window.scrollTo({ top: Math.max(0, host.offsetTop - 70), behavior:"smooth" });
    });
  }
  tw.appendChild(d);
});

/* ---------------------------------------------------------------- tabs --- */
var TABS = [
  {id:"ov",   label:"Overview",     n:null},
  {id:"os",   label:"Distro packages",  n:totOs},
  {id:"lib",  label:"Libraries",    n:totLib}
];
if (PATCH && PATCH.length) TABS.push({id:"patch", label:"Patch results", n:PATCH.length});

var tabsEl = document.getElementById("tabs");
TABS.forEach(function(t, i){
  var b = el("button","tab"); b.type="button"; b.setAttribute("role","tab");
  b.id = "tab-"+t.id; b.setAttribute("aria-controls","p-"+t.id);
  b.setAttribute("aria-selected", i===0 ? "true":"false");
  b.appendChild(document.createTextNode(t.label));
  if (t.n != null) { var s = el("span","n", t.n.toLocaleString()); b.appendChild(s); }
  b.addEventListener("click", function(){ select(t.id); });
  tabsEl.appendChild(b);
});
function select(id){
  TABS.forEach(function(t){
    var on = t.id === id;
    document.getElementById("tab-"+t.id).setAttribute("aria-selected", on?"true":"false");
    document.getElementById("p-"+t.id).classList.toggle("on", on);
  });
}
select("ov");

/* -------------------------------------------------------------- ribbons -- */
function ribbon(rows){
  var frag = document.createDocumentFragment();
  var c = sevCounts(rows), tot = rows.length || 1;
  var bar = el("div","ribbon");
  c.forEach(function(n, i){
    if (!n) return;
    var s = document.createElement("span");
    s.style.width = (n/tot*100) + "%";
    s.style.background = "var(" + SEVVAR[i] + ")";
    s.title = SEV[i] + ": " + n.toLocaleString();
    bar.appendChild(s);
  });
  frag.appendChild(bar);
  var lg = el("div","rlegend");
  c.forEach(function(n, i){
    if (!n) return;
    var sp = el("span");
    var sw = el("i"); sw.style.background = "var(" + SEVVAR[i] + ")";
    sp.appendChild(sw);
    sp.appendChild(document.createTextNode(SEV[i] + " " + n.toLocaleString()));
    lg.appendChild(sp);
  });
  frag.appendChild(lg);
  return frag;
}
var ovr = document.getElementById("ov-ribbons");
[["Distro packages", byCls[0]], ["Libraries", byCls[1]]].forEach(function(p){
  if (!p[1].length) return;
  var h = el("div", null);
  var lab = el("div", null, p[0] + " — " + p[1].length.toLocaleString() + " findings");
  lab.style.cssText = "font-size:12px;font-weight:600;color:var(--ink);margin-bottom:6px";
  h.appendChild(lab); h.appendChild(ribbon(p[1]));
  ovr.appendChild(h);
});

/* ------------------------------------------------------------- overview -- */
var ovSort = {k:"gt", dir:-1};
function ovRows(){
  var q = document.getElementById("ov-q").value.trim().toLowerCase();
  var rows = IMAGES_SUMMARY.filter(function(r){ return !q || r.img.toLowerCase().indexOf(q) >= 0; });
  var k = ovSort.k, d = ovSort.dir;
  return rows.sort(function(a,b){
    var x=a[k], y=b[k];
    if (typeof x === "string") return d * x.localeCompare(y);
    return d * (x - y);
  });
}
function drawOv(){
  var tb = document.querySelector("#ov-t tbody");
  tb.textContent = "";
  var rows = ovRows();
  rows.forEach(function(r){
    var tr = document.createElement("tr");
    tr.appendChild(el("td","m", r.img));
    tr.appendChild(el("td", null, r.ostype || "—"));
    tr.appendChild(el("td","num", r.ot.toLocaleString()));
    tr.appendChild(el("td","num", r.of.toLocaleString()));
    tr.appendChild(el("td", null, r.libtype || "—"));
    tr.appendChild(el("td","num", r.lt.toLocaleString()));
    tr.appendChild(el("td","num", r.lf.toLocaleString()));
    tr.appendChild(el("td","num", r.gt.toLocaleString()));
    tb.appendChild(tr);
  });
  document.getElementById("ov-empty").textContent = rows.length ? "" : "No images match that filter.";
  markSort("#ov-t", ovSort);
}
document.getElementById("ov-q").addEventListener("input", drawOv);
document.querySelectorAll("#ov-t th.s").forEach(function(th){
  th.addEventListener("click", function(){
    var k = th.dataset.k;
    ovSort = {k:k, dir: ovSort.k===k ? -ovSort.dir : (k==="img"||k==="ostype"||k==="libtype" ? 1 : -1)};
    drawOv();
  });
});
document.getElementById("ov-csv").addEventListener("click", function(){
  csvOut(["image","os_type","os_total","os_fixable","lib_type","lib_total","lib_fixable","grand_total"],
    ovRows().map(function(r){ return [r.img,r.ostype,r.ot,r.of,r.libtype,r.lt,r.lf,r.gt]; }),
    "layerops-images.csv");
});
function markSort(sel, st){
  document.querySelectorAll(sel + " th.s .ar").forEach(function(a){ a.textContent = ""; });
  var th = document.querySelector(sel + ' th.s[data-k="' + st.k + '"] .ar');
  if (th) th.textContent = st.dir > 0 ? "▲" : "▼";
}
drawOv();

/* ------------------------------------------------- CVE panels (os / lib) - */
function buildPanel(cls, host){
  var rows = byCls[cls];
  /* mode: "cve"  one row per distinct CVE  (matches the Distinct CVEs tile exactly)
           "pair" one row per CVE + package (the remediation unit)
           "flat" one row per occurrence, per image                                */
  var state = {q:"", sev:new Set(), fix:"", img:"", mode:"cve", sort:{k:"sev",dir:1}, page:0};

  /* --- controls --- */
  var f = el("div","filters");
  var sw = el("div","search");
  var inp = document.createElement("input");
  inp.type="search"; inp.placeholder="Search CVE, package, image…"; inp.setAttribute("aria-label","Search findings");
  sw.appendChild(inp); f.appendChild(sw);

  var chips = el("div","chips");
  SEV.forEach(function(s, i){
    var c = el("button","chip"); c.type="button"; c.dataset.sev=i;
    c.setAttribute("aria-pressed","false"); c.textContent = s;
    c.addEventListener("click", function(){
      if (state.sev.has(i)) state.sev.delete(i); else state.sev.add(i);
      c.setAttribute("aria-pressed", state.sev.has(i)?"true":"false");
      state.page=0; draw();
    });
    chips.appendChild(c);
  });
  f.appendChild(chips);

  var fixc = el("div","chips");
  [["fixable","Fixable"],["unfixed","Unfixed"]].forEach(function(p){
    var c = el("button","chip fx"); c.type="button"; c.textContent = p[1];
    c.setAttribute("aria-pressed","false");
    c.addEventListener("click", function(){
      state.fix = state.fix === p[0] ? "" : p[0];
      fixc.querySelectorAll(".chip").forEach(function(o){ o.setAttribute("aria-pressed","false"); });
      if (state.fix) c.setAttribute("aria-pressed","true");
      state.page=0; draw();
    });
    fixc.appendChild(c);
  });
  f.appendChild(fixc);
  host.appendChild(f);

  var f2 = el("div","filters");
  var isel = document.createElement("select"); isel.className="sel"; isel.setAttribute("aria-label","Filter by image");
  var o0 = document.createElement("option"); o0.value=""; o0.textContent="All images"; isel.appendChild(o0);
  var imgsHere = [];
  var seen = {};
  rows.forEach(function(r){ if(!seen[r[R_IMG]]){ seen[r[R_IMG]]=1; imgsHere.push(r[R_IMG]); } });
  imgsHere.sort(function(a,b){ return IMGS[a].localeCompare(IMGS[b]); }).forEach(function(ix){
    var o = document.createElement("option"); o.value = ix; o.textContent = IMGS[ix]; isel.appendChild(o);
  });
  isel.addEventListener("change", function(){ state.img = isel.value; state.page=0; draw(); });
  f2.appendChild(isel);

  var msel = document.createElement("select"); msel.className="sel"; msel.setAttribute("aria-label","Row grouping");
  [["cve","One row per distinct CVE"],["pair","One row per CVE + package"],["flat","One row per image"]]
    .forEach(function(p){
      var o = document.createElement("option"); o.value=p[0]; o.textContent=p[1]; msel.appendChild(o);
    });
  msel.value = state.mode;
  msel.addEventListener("change", function(){
    state.mode = msel.value; state.sort = {k:"sev", dir:1}; state.page = 0; draw();
  });
  f2.appendChild(msel);

  f2.appendChild(el("div","spacer"));
  var cbtn = el("button","btn pri"); cbtn.type="button"; cbtn.textContent="Copy filtered as CSV";
  f2.appendChild(cbtn);
  host.appendChild(f2);

  var rib = el("div"); host.appendChild(rib);

  var tw2 = el("div","tw");
  var table = document.createElement("table");
  var thead = document.createElement("thead");
  var tbody = document.createElement("tbody");
  table.appendChild(thead); table.appendChild(tbody);
  tw2.appendChild(table); host.appendChild(tw2);

  var emptyEl = el("div","empty"); emptyEl.style.display="none"; host.appendChild(emptyEl);

  var pager = el("div","pager");
  var prev = el("button","btn"); prev.type="button"; prev.textContent="← Prev";
  var next = el("button","btn"); next.type="button"; next.textContent="Next →";
  var info = el("span","info");
  pager.appendChild(prev); pager.appendChild(next); pager.appendChild(info);
  host.appendChild(pager);

  var deb;
  inp.addEventListener("input", function(){
    clearTimeout(deb);
    deb = setTimeout(function(){ state.q = inp.value.trim().toLowerCase(); state.page=0; draw(); }, 140);
  });
  prev.addEventListener("click", function(){ if (state.page>0){ state.page--; draw(); window.scrollTo({top:tw2.offsetTop-90}); } });
  next.addEventListener("click", function(){ state.page++; draw(); window.scrollTo({top:tw2.offsetTop-90}); });

  /* --- filtering --- */
  function filtered(){
    var q = state.q, hasSev = state.sev.size > 0, img = state.img === "" ? null : +state.img;
    return rows.filter(function(r){
      if (hasSev && !state.sev.has(r[R_SEV])) return false;
      if (state.fix === "fixable" && !r[R_FIX]) return false;
      if (state.fix === "unfixed" && r[R_FIX]) return false;
      if (img !== null && r[R_IMG] !== img) return false;
      if (q) {
        if (r[R_CVE].toLowerCase().indexOf(q) < 0 &&
            r[R_PKG].toLowerCase().indexOf(q) < 0 &&
            IMGS[r[R_IMG]].toLowerCase().indexOf(q) < 0 &&
            String(r[R_TYPE]).toLowerCase().indexOf(q) < 0) return false;
      }
      return true;
    });
  }
  /* group by CVE+package (mode "pair") or by CVE alone (mode "cve") */
  function grouped(rs, byCveOnly){
    var m = new Map();
    rs.forEach(function(r){
      var key = byCveOnly ? r[R_CVE] : (r[R_CVE] + "\u0001" + r[R_PKG]);
      var g = m.get(key);
      if (!g) {
        g = {cve:r[R_CVE], pkg:r[R_PKG], sev:r[R_SEV],
             pkgs:new Set(), inst:new Set(), imgs:new Set(),
             fixed:0, unfixed:0, fixVers:new Set()};
        m.set(key, g);
      }
      if (r[R_SEV] < g.sev) g.sev = r[R_SEV];          /* most severe wins */
      g.pkgs.add(r[R_PKG]); g.inst.add(r[R_INST]); g.imgs.add(r[R_IMG]);
      if (r[R_FIX]) { g.fixed++; g.fixVers.add(r[R_FIX]); } else { g.unfixed++; }
    });
    /* one fix label per group: a version when unambiguous, else the split */
    m.forEach(function(g){
      if (g.fixed && !g.unfixed) g.fix = g.fixVers.size === 1 ? Array.from(g.fixVers)[0] : "fix available";
      else if (g.fixed && g.unfixed) g.fix = "partial";
      else g.fix = "";
    });
    return Array.from(m.values());
  }
  function sortRows(list){
    var k = state.sort.k, d = state.sort.dir, flat = state.mode === "flat";
    return list.sort(function(a,b){
      var x,y;
      if (!flat) {
        if (k==="sev"){x=a.sev;y=b.sev;} else if (k==="cve"){x=a.cve;y=b.cve;}
        else if (k==="pkg"){ x = state.mode==="cve" ? a.pkgs.size : a.pkg;
                             y = state.mode==="cve" ? b.pkgs.size : b.pkg; }
        else if (k==="imgs"){x=a.imgs.size;y=b.imgs.size;}
        else {x=a.fixed?1:0;y=b.fixed?1:0;}
      } else {
        if (k==="sev"){x=a[R_SEV];y=b[R_SEV];} else if (k==="cve"){x=a[R_CVE];y=b[R_CVE];}
        else if (k==="pkg"){x=a[R_PKG];y=b[R_PKG];} else if (k==="img"){x=IMGS[a[R_IMG]];y=IMGS[b[R_IMG]];}
        else {x=a[R_FIX]?1:0;y=b[R_FIX]?1:0;}
      }
      if (typeof x === "string") return d * x.localeCompare(y);
      return d * (x - y);
    });
  }
  /* "N things", expandable when there is more than one */
  function setCell(td, items, noun) {
    if (items.length === 1) { td.appendChild(el("span","imgs", items[0])); return; }
    var dt = document.createElement("details"); dt.className = "imgd";
    var sm = document.createElement("summary"); sm.textContent = items.length + " " + noun;
    dt.appendChild(sm);
    var ul = document.createElement("ul");
    items.slice().sort().forEach(function(v){ ul.appendChild(el("li", null, v)); });
    dt.appendChild(ul); td.appendChild(dt);
  }

  function header(cols){
    thead.textContent = "";
    var tr = document.createElement("tr");
    cols.forEach(function(c){
      var th = el("th", c.k ? "s" : null, c.label);
      if (c.right) th.style.textAlign = "right";
      if (c.k) {
        th.dataset.k = c.k;
        var ar = el("span","ar", state.sort.k===c.k ? (state.sort.dir>0?"▲":"▼") : "");
        th.appendChild(ar);
        th.addEventListener("click", function(){
          state.sort = {k:c.k, dir: state.sort.k===c.k ? -state.sort.dir : (c.k==="sev"?1:1)};
          state.page = 0; draw();
        });
      }
      tr.appendChild(th);
    });
    thead.appendChild(tr);
  }

  function draw(){
    var fl = filtered();
    rib.textContent = ""; rib.appendChild(ribbon(fl));

    var list = state.mode === "flat" ? fl.slice() : grouped(fl, state.mode === "cve");
    sortRows(list);

    var pages = Math.max(1, Math.ceil(list.length / PAGE));
    if (state.page >= pages) state.page = pages - 1;
    var start = state.page * PAGE, slice = list.slice(start, start + PAGE);

    if (state.mode === "cve") {
      header([{label:"CVE",k:"cve"},{label:"Severity",k:"sev"},{label:"Packages",k:"pkg",right:true},
              {label:"Fix",k:"fix"},{label:"Images",k:"imgs",right:true},{label:"Title"}]);
    } else if (state.mode === "pair") {
      header([{label:"CVE",k:"cve"},{label:"Severity",k:"sev"},{label:"Package",k:"pkg"},
              {label:"Installed"},{label:"Fixed in",k:"fix"},{label:"Images",k:"imgs",right:true},{label:"Title"}]);
    } else {
      header([{label:"CVE",k:"cve"},{label:"Severity",k:"sev"},{label:"Image",k:"img"},
              {label:"Type"},{label:"Package",k:"pkg"},{label:"Installed"},{label:"Fixed in",k:"fix"}]);
    }

    tbody.textContent = "";
    slice.forEach(function(g){
      var tr = document.createElement("tr");
      if (state.mode === "cve") {
        var tdc = document.createElement("td");
        var ac = el("a","cve", g.cve); ac.href = cveHref(g.cve); ac.target="_blank"; ac.rel="noopener noreferrer";
        tdc.appendChild(ac); tr.appendChild(tdc);

        var tsc = document.createElement("td");
        tsc.appendChild(el("span","sev sev"+g.sev, SEV[g.sev])); tr.appendChild(tsc);

        var tp = document.createElement("td"); tp.style.textAlign = "right";
        setCell(tp, Array.from(g.pkgs), "packages"); tr.appendChild(tp);

        var tfx = document.createElement("td");
        if (g.fix === "partial") tfx.appendChild(el("span","nofix","partial"));
        else if (g.fix) tfx.appendChild(el("span","fixv", g.fix));
        else tfx.appendChild(el("span","nofix","no fix"));
        tr.appendChild(tfx);

        var tic = document.createElement("td"); tic.style.textAlign = "right";
        setCell(tic, Array.from(g.imgs).map(function(i){ return IMGS[i]; }), "images");
        tr.appendChild(tic);

        tr.appendChild(el("td","ttl", TITLES[g.cve] || ""));
      } else if (state.mode === "pair") {
        var td = document.createElement("td");
        var a = el("a","cve", g.cve); a.href = cveHref(g.cve); a.target="_blank"; a.rel="noopener noreferrer";
        td.appendChild(a); tr.appendChild(td);

        var ts = document.createElement("td");
        ts.appendChild(el("span","sev sev"+g.sev, SEV[g.sev])); tr.appendChild(ts);

        tr.appendChild(el("td","m", g.pkg));
        tr.appendChild(el("td","m", Array.from(g.inst).slice(0,2).join(", ") + (g.inst.size>2 ? " +"+(g.inst.size-2) : "")));

        var tf = document.createElement("td");
        if (g.fix === "partial") tf.appendChild(el("span","nofix","partial"));
        else if (g.fix) tf.appendChild(el("span","fixv", g.fix));
        else tf.appendChild(el("span","nofix","no fix"));
        tr.appendChild(tf);

        var ti = document.createElement("td"); ti.style.textAlign="right";
        if (g.imgs.size === 1) {
          ti.appendChild(el("span","imgs","1"));
        } else {
          var d = document.createElement("details"); d.className="imgd";
          var s = document.createElement("summary"); s.textContent = g.imgs.size + " images";
          d.appendChild(s);
          var ul = document.createElement("ul");
          Array.from(g.imgs).sort(function(a,b){return IMGS[a].localeCompare(IMGS[b]);})
            .forEach(function(ix){ ul.appendChild(el("li", null, IMGS[ix])); });
          d.appendChild(ul); ti.appendChild(d);
        }
        tr.appendChild(ti);
        tr.appendChild(el("td","ttl", TITLES[g.cve] || ""));
      } else {
        var td2 = document.createElement("td");
        var a2 = el("a","cve", g[R_CVE]); a2.href = cveHref(g[R_CVE]); a2.target="_blank"; a2.rel="noopener noreferrer";
        td2.appendChild(a2); tr.appendChild(td2);

        var ts2 = document.createElement("td");
        ts2.appendChild(el("span","sev sev"+g[R_SEV], SEV[g[R_SEV]])); tr.appendChild(ts2);

        tr.appendChild(el("td","m", IMGS[g[R_IMG]]));
        tr.appendChild(el("td", null, g[R_TYPE] || "—"));
        tr.appendChild(el("td","m", g[R_PKG]));
        tr.appendChild(el("td","m", g[R_INST]));
        var tf2 = document.createElement("td");
        if (g[R_FIX]) tf2.appendChild(el("span","fixv", g[R_FIX]));
        else tf2.appendChild(el("span","nofix","no fix"));
        tr.appendChild(tf2);
      }
      tbody.appendChild(tr);
    });

    emptyEl.style.display = list.length ? "none" : "block";
    emptyEl.textContent = list.length ? "" : "Nothing matches these filters.";
    info.textContent = list.length
      ? ((start+1).toLocaleString() + "–" + Math.min(start+PAGE, list.length).toLocaleString() +
         " of " + list.length.toLocaleString() +
         (state.mode === "cve" ? " distinct CVEs" : state.mode === "pair" ? " CVE/package pairs" : " findings") +
         "  ·  page " + (state.page+1) + " of " + pages)
      : "0 results";
    prev.disabled = state.page === 0;
    next.disabled = state.page >= pages - 1;
    prev.style.opacity = prev.disabled ? .4 : 1;
    next.style.opacity = next.disabled ? .4 : 1;

    cbtn.onclick = function(){
      if (state.mode === "cve") {
        csvOut(["cve","severity","packages","fix","image_count","images","title"],
          list.map(function(g){
            return [g.cve, SEV[g.sev], Array.from(g.pkgs).join(" | "),
                    g.fix || "no fix", g.imgs.size,
                    Array.from(g.imgs).map(function(i){return IMGS[i];}).join(" | "),
                    TITLES[g.cve] || ""];
          }), "layerops-" + (cls?"lib":"os") + "-distinct-cves.csv");
      } else if (state.mode === "pair") {
        csvOut(["cve","severity","package","installed","fixed_version","image_count","images","title"],
          list.map(function(g){
            return [g.cve, SEV[g.sev], g.pkg, Array.from(g.inst).join(" | "), g.fix || "no fix",
                    g.imgs.size, Array.from(g.imgs).map(function(i){return IMGS[i];}).join(" | "),
                    TITLES[g.cve] || ""];
          }), "layerops-" + (cls?"lib":"os") + "-cves.csv");
      } else {
        csvOut(["cve","severity","image","type","package","installed","fixed_version","title"],
          list.map(function(r){
            return [r[R_CVE], SEV[r[R_SEV]], IMGS[r[R_IMG]], r[R_TYPE], r[R_PKG], r[R_INST], r[R_FIX] || "",
                    TITLES[r[R_CVE]] || ""];
          }), "layerops-" + (cls?"lib":"os") + "-findings.csv");
      }
    };
  }
  draw();

  PANELS[cls ? "lib" : "os"] = {
    apply: function(mode, fix){
      if (mode) { state.mode = mode; msel.value = mode; }
      state.fix = fix || "";
      fixc.querySelectorAll(".chip").forEach(function(c, i){
        c.setAttribute("aria-pressed",
          (state.fix === "fixable" && i === 0) || (state.fix === "unfixed" && i === 1) ? "true" : "false");
      });
      state.page = 0;
      state.sort = {k:"sev", dir:1};
      draw();
    }
  };
}

/* each class gets a one-line statement of what remediation actually means there,
   so nobody reads a lib "fixable" count as something --patch will clear */
function classNote(host, kind){
  var n = el("div", "note" + (kind === "lib" ? " warn" : ""));
  if (kind === "os") {
    n.appendChild(el("b", null, "Patchable by layerops. "));
    n.appendChild(document.createTextNode(
      "These are distro packages. Where a fixed version exists, layerops --patch rebuilds the "
      + "package layer in place — no application change required. Fixable and Unfixed on the "
      + "overview count these findings only."));
  } else {
    n.appendChild(el("b", null, "Not patchable in place. "));
    n.appendChild(document.createTextNode(
      "These are compiled into the application — jar, Go binary, npm, pip. A “fixed version” "
      + "here means an upstream release exists, not that anything can apply it: each one needs a "
      + "dependency bump, a rebuild and a redeploy. layerops --patch never touches them, so they are "
      + "excluded from the Fixable and Unfixed figures on the overview."));
  }
  host.appendChild(n);
}

if (byCls[0].length) { classNote(document.getElementById("p-os"), "os"); buildPanel(0, document.getElementById("p-os")); }
else document.getElementById("p-os").appendChild(el("div","empty","No distro package findings."));
if (byCls[1].length) { classNote(document.getElementById("p-lib"), "lib"); buildPanel(1, document.getElementById("p-lib")); }
else document.getElementById("p-lib").appendChild(el("div","empty","No library findings."));

/* ---------------------------------------------------------------- patch -- */
if (PATCH && PATCH.length) {
  var ok = PATCH.filter(function(p){return p[4]==="PATCHED";}).length;
  var bad = PATCH.filter(function(p){return p[4]==="FAILED";}).length;
  var skip = PATCH.filter(function(p){return p[4]==="SKIPPED";}).length;
  var n = document.getElementById("patch-note");
  n.textContent = "";
  var b = el("b", null, "layerops patches distro packages only. ");
  n.appendChild(b);
  n.appendChild(document.createTextNode(
    ok + " patched, " + bad + " failed, " + skip + " skipped. Library findings are never affected by --patch — " +
    "they need a dependency bump and an application rebuild."));
  var ptb = document.querySelector("#pt-t tbody");
  PATCH.forEach(function(p){
    var tr = document.createElement("tr");
    tr.appendChild(el("td","m",p[0]));
    tr.appendChild(el("td","m",p[1]));
    var a=el("td","num",p[2]); tr.appendChild(a);
    var bcell=el("td","num",p[3]); tr.appendChild(bcell);
    var st=document.createElement("td");
    st.appendChild(el("span","status st-"+p[4], p[4])); tr.appendChild(st);
    tr.appendChild(el("td","num",p[5]));
    tr.appendChild(el("td","num",p[6]));
    ptb.appendChild(tr);
  });
}

/* --------------------------------------------------------------- footer -- */
var ft = document.getElementById("foot");
var parts = ["Generated by layerops " + (META.version||"") + " using Trivy" + (PATCH && PATCH.length ? " and Copacetic" : "") + "."];
if (META.failed && META.failed.length) parts.push(META.failed.length + " image(s) failed to scan: " + META.failed.join(", ") + ".");
parts.push("Findings are raw occurrences; distinct CVE counts are deduplicated. Severity is Trivy's, which may draw on multiple vendor sources.");
ft.textContent = parts.join(" ");
})();
</script>
</body>
</html>
LAYEROPS_HTML_TAIL
  } > "$out"
}

if [[ -n "$HTML_OUT" ]]; then
  write_html "$HTML_OUT"
  printf '%s: wrote %s (%s)\n' "$PROG" "$HTML_OUT" \
    "$(du -h "$HTML_OUT" 2>/dev/null | cut -f1 | tr -d ' ')" >&2
fi

# ------------------------------------------------------------------ footer ---
if [[ ${#FAILED[@]} -gt 0 ]]; then
  printf '%s: %d image(s) failed to scan:\n' "$PROG" "${#FAILED[@]}" >&2
  printf '  %s\n' "${FAILED[@]}" >&2
fi

if [[ ${#PATCH_FAILED_IMGS[@]} -gt 0 ]]; then
  printf '%s: %d image(s) failed to patch:\n' "$PROG" "${#PATCH_FAILED_IMGS[@]}" >&2
  printf '  %s\n' "${PATCH_FAILED_IMGS[@]}" >&2
fi

if [[ "$FAIL_ON_FIXABLE" -eq 1 ]]; then
  n="$(jq -rn '[ inputs | .Results[]?.Vulnerabilities[]? | select((.FixedVersion // "") != "") ] | length' "${JSONS[@]}")"
  if [[ "$n" -gt 0 ]]; then
    printf '%s: %s fixable vulnerabilities found\n' "$PROG" "$n" >&2
    exit 1
  fi
fi
